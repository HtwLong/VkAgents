# Server-side Next.js proxy target. Do not prefix this variable with NEXT_PUBLIC.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Set to viewer for a planning/results-only deployment. The frontend also checks
# /api/v1/capabilities at runtime; this build-time value provides a safe default.
NEXT_PUBLIC_DEPLOYMENT_MODE=full

# Normally leave unset so browser requests use the same-origin /api/backend proxy.
# Normally do not create NEXT_PUBLIC_API_BASE_URL in Vercel. If it exists but is
# blank, the frontend still falls back to the same-origin /api/backend proxy.
# NEXT_PUBLIC_API_BASE_URL=
