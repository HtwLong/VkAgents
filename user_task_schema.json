{
  "type": "object",
  "properties": {
    "problem": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": ["image classification", "object detection", "image segmentation"]
        },
        "application_domain": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["task", "application_domain", "description"],
      "additionalProperties": false
    },
    "dataset": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "classes": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "preprocessing": { "type": "string", "minLength": 0 },
          "augmentation": { "type": "string", "minLength": 0 },
          "source": { "type": "string", "minLength": 0 },
          "path_images": { "type": "string", "minLength": 0 },
          "number_images_per_class": { "type": ["integer", "null"] },
          "number_of_classes": { "type": ["integer", "null"] },
          "total_number_images": { "type": ["integer", "null"] },
          "path_labels": { "type": "string", "minLength": 0 }
        },
        "required": [
          "name", "classes", "description", "preprocessing", "augmentation",
          "source", "path_images", "number_images_per_class", "number_of_classes", "total_number_images", "path_labels"
        ],
        "additionalProperties": false
      }
    },
    "model": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 0 },
          "family": { "type": "string", "minLength": 0 },
          "height": {"type": ["number", "null"]},
          "width": {"type": ["number", "null"]},
          "color_channels": {"type": ["number", "null"]},
          "description": { "type": "string", "minLength": 0 }
        },
        "required": ["name", "family", "height", "width", "color_channels", "description"],
        "additionalProperties": false
      }
    },
    "performance_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 0 },
          "value": {"type": ["number", "null"]}
        },
        "required": ["name", "value"],
        "additionalProperties": false
      }
    }
  },
  "required": ["problem", "dataset", "model", "performance_metrics"],
  "additionalProperties": false
}
