# Copy this file to .env and add your real key. Never commit .env.
OPENAI_API_KEY=replace-me

# Optional settings
PLANNING_LLM_MODEL=gpt-5-nano
ASSESSMENT_LLM_MODEL=gpt-5-nano
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Use "all" on a single-GPU machine, a GPU index such as "0", or a GPU UUID.
NVIDIA_VISIBLE_DEVICES=all
